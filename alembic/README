Generic single-database configuration.

# ALEMBIC — простыми словами

# Alembic нужен для того, чтобы обновлять структуру базы данных,
# когда мы изменяем наши models.

# Например:

# Было:
# Book
# - id
# - title

# Мы изменили модель и добавили:
# - author

# Alembic помогает перенести это изменение из models
# в настоящую базу данных.

# Как это работает:

# 1. Устанавливаем Alembic

# pip install alembic

# 2. Создаём Alembic в проекте

# alembic init alembic

# После этой команды Alembic сам создаёт папку alembic
# и необходимые файлы внутри неё.

# 3. Подключаем наши модели

# В alembic/env.py подключаем Base и модели.

# Например:

# from database.database import Base
# from models.book import Book

# target_metadata = Base.metadata

# Это говорит Alembic:
# «Вот наши модели и описание таблиц.
# Следи за изменениями в них».

# 4. Меняем model

# Например, добавили новое поле в Book.

# 5. Создаём миграцию

# alembic revision --autogenerate -m "add author to books"

# Alembic смотрит, что изменилось в моделях,
# и создаёт специальный файл с инструкциями,
# как изменить базу данных.

# Этот файл появляется в:

# alembic/versions/

# 6. Применяем миграцию

# alembic upgrade head

# Теперь Alembic выполняет эти изменения
# и обновляет настоящую базу данных.

# Главная идея:

# Мы изменили model
        ↓
# Alembic заметил изменение
        ↓
# Создал migration
        ↓
# Мы применили migration
        ↓
# База данных обновилась


# Самое главное:

# Models — говорят, какой должна быть структура таблиц.

# Alembic — переносит изменения из models в базу данных.

# Migration — это инструкция для базы:
# «что именно нужно изменить».